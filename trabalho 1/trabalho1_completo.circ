  <vhdl name="meu_bin2bcd5bits">LIBRARY ieee;&#13;
USE ieee.std_logic_1164.all;&#13;
&#13;
ENTITY meu_bin2bcd5bits IS&#13;
  PORT (&#13;
  	BIN: IN std_logic_vector(4 downto 0);
  	BCD0, BCD1: OUT std_logic_vector(3 downto 0)
    );&#13;
END meu_bin2bcd5bits;&#13;
&#13;
ARCHITECTURE TypeArchitecture OF meu_bin2bcd5bits IS&#13;
    
BEGIN&#13;
	shift_bcd: process(BIN) is
		variable BIN_org: std_logic_vector(4 DOWNTO 0);
    		variable BCD0_org, BCD1_org: std_logic_vector(3 DOWNTO 0);
    		variable BIN_shf: std_logic_vector(4 DOWNTO 0);
    		variable BCD0_shf, BCD1_shf: std_logic_vector(3 DOWNTO 0);
	begin
		BIN_org := BIN;
		BCD0_org := "0000";
		BCD1_org := "0000";
		rayron: for i in 4 downto 0 loop
		   	--somar 3 quando maior que 5
			case BCD0_org is
				when "0101" =&gt;
					BCD0_shf := "1000";
				when "0110" =&gt;
					BCD0_shf := "1001";
				when "0111" =&gt;
					BCD0_shf := "1010";
				when "1000" =&gt;
					BCD0_shf := "1011";
				when "1001" =&gt;
					BCD0_shf := "1100";
				when "1010" =&gt;
					BCD0_shf := "1101";
				when "1011" =&gt;
					BCD0_shf := "1110";
				when "1100" =&gt;
					BCD0_shf := "1111";
				when others =&gt;
					BCD0_shf := BCD0_org;
		    	end case;
				
			case BCD1_org is
				when "0101" =&gt;
					BCD1_shf := "1000";
				when "0110" =&gt;
					BCD1_shf := "1001";
				when "0111" =&gt;
					BCD1_shf := "1010";
				when "1000" =&gt;
					BCD1_shf := "1011";
				when "1001" =&gt;
					BCD1_shf := "1100";
				when "1010" =&gt;
					BCD1_shf := "1101";
				when "1011" =&gt;
					BCD1_shf := "1110";
				when "1100" =&gt;
					BCD1_shf := "1111";
				when others =&gt;
					BCD1_shf := BCD1_org;
			end case;
			BCD0_org := BCD0_shf;
			BCD1_org := BCD1_shf;
			
			--mudar primeira celula do bcd
			for i in 2 downto 0 loop
				BCD1_shf(i + 1) := BCD1_org(i);
			end loop;
			BCD1_shf(0) := BCD0_org(3);
	
			--mudar segunda celula do bcd
			for i in 2 downto 0 loop
				BCD0_shf(i + 1) := BCD0_org(i);
			end loop;
			BCD0_shf(0) := BIN_org(4);
	
			--mudar o binario
			for i in 3 downto 0 loop
				BIN_shf(i + 1) := BIN_org(i);
			end loop;
			BIN_shf(0) := '0';
	
			BIN_org := BIN_shf;
			BCD0_org := BCD0_shf;
			BCD1_org := BCD1_shf;

		 end loop rayron;
		 BCD0 &lt;= BCD0_org;
		 BCD1 &lt;= BCD1_org;
	end process shift_bcd;

END TypeArchitecture;&#13;
</vhdl>
  <vhdl name="meu_dec2bin4bits">LIBRARY ieee;&#13;
USE ieee.std_logic_1164.all;&#13;
&#13;
ENTITY meu_dec2bin4bits IS&#13;
  PORT (&#13;
    a0, a1, a2, a3, a4, a5, a6, a7, a8, a9: IN std_logic;
    A, B, C, D: OUT std_logic
    );&#13;
END meu_dec2bin4bits;&#13;
&#13;
ARCHITECTURE TypeArchitecture OF meu_dec2bin4bits IS&#13;
&#13;
BEGIN&#13;
&#13;	A &lt;= a9 or a8;
	B &lt;= a4 or a5 or a6 or a7;
	C &lt;= a2 or a3 or a6 or a7;
	D &lt;= a1 or a3 or a5 or a7 or a9;
&#13;
END TypeArchitecture;&#13;
</vhdl>
  <vhdl name="meu_bin2dec5bits">LIBRARY ieee;
USE ieee.std_logic_1164.all;

ENTITY meu_bin2dec5bits IS
  PORT (
  	--entrada do binario de 5 bits
  	BIN_4, BIN_3, BIN_2, BIN_1, BIN_0: IN std_logic;

  	--saídas dos displays
  	S_a0, S_b0, S_c0, S_d0, S_e0, S_f0, S_g0: OUT std_logic; --display da unidade
  	S_a1, S_b1, S_c1, S_d1, S_e1, S_f1, S_g1: OUT std_logic  --display da dezena
    );
END meu_bin2dec5bits;

ARCHITECTURE TypeArchitecture OF meu_bin2dec5bits IS
    signal a1, b1, c1, d1: std_logic; --auxiliares
    signal e1, f1, g1, h1: std_logic; --auxiliares 
BEGIN
	process(BIN_4, BIN_3, BIN_2, BIN_1, BIN_0) is
		variable BIN_org: std_logic_vector(4 DOWNTO 0);
    		variable BCD0_org, BCD1_org: std_logic_vector(3 DOWNTO 0);
    		
    		variable BIN_shf: std_logic_vector(4 DOWNTO 0);
    		variable BCD0_shf, BCD1_shf: std_logic_vector(3 DOWNTO 0);
    		
    		variable a, b, c, d: std_logic;
    		variable e, f, g, h: std_logic;
	begin
		BIN_org(4) := BIN_4; BIN_org(3) := BIN_3;
		BIN_org(2) := BIN_2; BIN_org(1) := BIN_1;
		BIN_org(0) := BIN_0;
		
		BCD0_org := "0000";
		BCD1_org := "0000";
		for i in 4 downto 0 loop
			a := BCD0_org(3); b := BCD0_org(2);
			c := BCD0_org(1); d := BCD0_org(0);
			
			e := BCD1_org(3); f := BCD1_org(2);
			g := BCD1_org(1); h := BCD1_org(0);
			
		   	--somar 3 quando maior que 5
		   	BCD0_shf(3) := ((b and d) or (b and c)) or a;
		   	BCD0_shf(2) := (b and not c and not d) or (a and d) or (a and c);
		   	BCD0_shf(1) := (not a and not b and c) or (c and d) or (a and not c and not d) or (a and b and not d);
		   	BCD0_shf(0) := (not a and not b and d) or (not a and b and c and not d) or (a and not b and not d) or (a and b and d) or (a and not c and not d);
				
			BCD1_shf(3) := (f and h) or (f and g) or e;
		   	BCD1_shf(2) := (f and not g and not h) or (e and h) or (e and g);
		   	BCD1_shf(1) := (not e and not f and g) or (g and h) or (e and not g and not h) or (e and f and not h);
		   	BCD1_shf(0) := (not e and not f and h) or (not e and f and g and not h) or (e and not f and not h) or (e and f and h) or (e and not g and not h);
			
			BCD0_org := BCD0_shf;
			BCD1_org := BCD1_shf;
			
			--mudar primeira celula do bcd
			BCD1_shf(3) := BCD1_org(2);
			BCD1_shf(2) := BCD1_org(1);
			BCD1_shf(1) := BCD1_org(0);
			BCD1_shf(0) := BCD0_org(3);
			
			--mudar segunda celula do bcd
			BCD0_shf(3) := BCD0_org(2);
			BCD0_shf(2) := BCD0_org(1);
			BCD0_shf(1) := BCD0_org(0);
			BCD0_shf(0) := BIN_org(4);
			
			--mudar o binario
			BIN_shf(4) := BIN_org(3);
			BIN_shf(3) := BIN_org(2);
			BIN_shf(2) := BIN_org(1);
			BIN_shf(1) := BIN_org(0);
			BIN_shf(0) := '0';
			
			BIN_org := BIN_shf;
			BCD0_org := BCD0_shf;
			BCD1_org := BCD1_shf;
		 end loop;
		 
		--Bits do bcd da unidade
		a1 &lt;= BCD0_org(3); b1 &lt;= BCD0_org(2);
		c1 &lt;= BCD0_org(1); d1 &lt;= BCD0_org(0);
		
		--Bits do bcd da dezena
		e1 &lt;= BCD1_org(3); f1 &lt;= BCD1_org(2);
		g1 &lt;= BCD1_org(1); h1 &lt;= BCD1_org(0);
	end process;
	
	--Primeiro display
	S_a0 &lt;= a1 or c1 or not ((not b1 and d1) or (b1 and not d1));
	
	S_b0 &lt;= not b1 or not ((not c1 and d1) or (c1 and not d1));
	
	S_c0 &lt;= b1 or not c1 or d1;
	
	S_d0 &lt;= a1 or 
		(not b1 and not d1) or
		(not b1 and c1) or
		(c1 and not d1) or
		(b1 and not c1 and d1);

	S_e0 &lt;= (not b1 and not d1) or
		(c1 and not d1);

	S_f0 &lt;= a1 or
		(not c1 and not d1) or
		(b1 and not c1) or
		(b1 and not d1);

	S_g0 &lt;= a1 or
		((not b1 and c1) or (b1 and not c1)) or
		(c1 and not d1);

	--Segundo display
	S_a1 &lt;= e1 or g1 or not ((not f1 and h1) or (f1 and not h1));
	
	S_b1 &lt;= not f1 or not ((not g1 and h1) or (g1 and not h1));
	
	S_c1 &lt;= f1 or not g1 or h1;
	
	S_d1 &lt;= e1 or 
		(not f1 and not h1) or
		(not f1 and g1) or
		(g1 and not h1) or
		(f1 and not g1 and h1);

	S_e1 &lt;= (not f1 and not h1) or
		(g1 and not h1);

	S_f1 &lt;= e1 or
		(not g1 and not h1) or
		(f1 and not g1) or
		(f1 and not h1);

	S_g1 &lt;= e1 or
		((not g1 and f1) or (g1 and not f1)) or
		(g1 and not h1);
	
END TypeArchitecture;
</vhdl>
  <vhdl name="meu_bcd2dec">LIBRARY ieee;
USE ieee.std_logic_1164.all;

ENTITY meu_bcd2dec IS
  PORT (
  	BCD: IN std_logic_vector(3 downto 0);
  	a, b, c, d, e, f, g, h: OUT std_logic
    );
END meu_bcd2dec;

ARCHITECTURE TypeArchitecture OF meu_bcd2dec IS
    signal A, B, C, D: std_logic;
BEGIN
	A &lt;= BCD(3); B &lt;= BCD(2);
	C &lt;= BCD(1); D &lt;= BCD(0);
	
	--Primeiro display
	a &lt;= A or C or not (B xor D);
	
	b &lt;= not B or not (C xor D);
	
	c &lt;= B or not C or D;
	
	d &lt;= A or 
		(not B and not D) or
		(not B and C) or
		(C and not D) or
		(B and not C and D);

	e &lt;= (not B and not D) or
		(C and not D);

	f &lt;= A or
		(not C and not D) or
		(B and not C) or
		(B and not D);

	g &lt;= A or
		(B xor C) or
		(C and not D);
	
END TypeArchitecture;
</vhdl>
</project>
